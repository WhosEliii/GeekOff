package geekoff;

import flixel.FlxG;
import flixel.FlxSprite;
import funkin.ui.FullScreenScaleMode;
import flixel.util.FlxTimer;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.text.FlxText;
import flixel.text.FlxTextFormat;
import flixel.text.FlxTextAlign;
import flixel.text.FlxTextBorderStyle;
import flixel.util.FlxColor;
import funkin.graphics.FunkinSprite;
import flixel.input.keyboard.FlxKeyboard;
import funkin.InitState;
import funkin.audio.FunkinSound;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
import funkin.ui.mainmenu.MainMenuState;
import funkin.ui.MusicBeatState;

class GeekCustomMenu extends MusicBeatState
{
  var song:FunkinSound;
  var bg:FunkinSprite;
  var konataBlunt:FunkinSprite;
  var logo:FunkinSprite;
  var confirm:FunkinSprite;
  var title:FlxText = new FlxText(FullScreenScaleMode?.gameNotchSize?.x, FlxG.height - 24, FlxG.width);

  override public function create():Void
  {
    super.create();
    FlxG.camera.fade(FlxColor.BLACK, 0.3, true);

    bg = FunkinSprite.create(0, 0, 'ui/title/bg');
    bg.screenCenter();
    add(bg);

    konataBlunt = FunkinSprite.createSparrow(700, 15, 'ui/title/konata-title');
    konataBlunt.animation.addByPrefix('idle', 'gfDance', 24, true);
    konataBlunt.animation.play('idle');
    add(konataBlunt);

    title.text = "© 2026 The GEEK OFF Developers (name pending). Not one right reserved.";
    title.setFormat(Paths.font('vcr.ttf'), 16, FlxColor.WHITE, "left", FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
    add(title);

    logo = FunkinSprite.createSparrow(60, 32, 'ui/title/logo-geek');
    logo.animation.addByPrefix('idle', 'logo bumpin', 24, true);
    logo.animation.play('idle');
    add(logo);

    confirm = FunkinSprite.createTextureAtlas(180 + (FullScreenScaleMode.gameCutoutSize.x / 2), FlxG.height * 0.8 - 50, 'ui/title/title-screen-text-geek');
    confirm.anim.addByFrameLabel('idle', "-export/Press Enter to Begin", 24);
    confirm.anim.addByFrameLabel('press', "-export/ENTER PRESSED", 24);
    confirm.animation.play('idle');
    add(confirm);

    song = FunkinSound.playMusic('ui/main-menu/freaky-menu-geek/freaky-menu-geek',
      {
        overrideExisting: true,
        restartTrack: false,
      });
  }

  override function update(elapsed:Float)
  {
    super.update(elapsed);

    if (FlxG.keys.justPressed.ENTER && !FlxG.keys.justPressed.TAB) {

      FlxG.camera.flash(FlxColor.WHITE, 0.5);
      FunkinSound.playOnce(Paths.sound('ui/main-menu/confirm-menu').toString(), 0.7);

      FlxTween.tween(bg, {alpha: 0}, 0.8, {startDelay: 1, ease: FlxEase.expoInOut});
      FlxTween.tween(title, {alpha: 0}, 0.5, {ease: FlxEase.expoOut});
      FlxTween.tween(konataBlunt, {x: 1300}, 1, {ease: FlxEase.expoIn});
      FlxTween.tween(logo, {x: -700}, 1, {ease: FlxEase.expoIn});
      FlxG.sound.music.fadeOut(1.0, 0);

      confirm.animation.play('press');
      FlxTween.tween(confirm, {alpha: 0}, 0.5, {startDelay: 0.5, ease: FlxEase.expoOut});

      

      new FlxTimer().start(1.8, _->{
            FlxG.switchState(new MainMenuState());
        });
    }
  }
}

class GeekMenuModule extends Module
{
  public function new()
  {
    super('GeekMenuModule', 0);
  }

override public function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    if (InitState.customTitleState == null) InitState.customTitleState = new GeekCustomMenu();
  }
}

import funkin.input.Controls;
import funkin.util.WindowUtil;

class GeekMenuReturn extends Module {
    public function new():Void {
        super("GeekMenuReturn", 1, {
            state: MainMenuState
        });
    }

    override function onUpdate(elapsed) {
        super.onUpdate(elapsed);

        // if (controls.BACK_P) switchState(new GeekCustomMenu());
    }
}
